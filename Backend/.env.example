NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Set true only when deployed behind exactly one trusted reverse proxy.
TRUST_PROXY=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Development-only webhook tunnel. Never enable this in production.
ENABLE_NGROK=false
NGROK_DOMAIN=
NGROK_AUTHTOKEN=

# Optional operational limits
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_STALE_MS=300000
REQUEST_BODY_LIMIT=100kb
WEBHOOK_BODY_LIMIT=1mb
